{
  "fontFamily": "Harmony",
  "liquidGlass": {
    "thickness": 20,
    "blur": 5,
    "glassColor": "#00FFFFFF",
    "specularSharpness": "medium",
    "visibility": 1.0,
    "chromaticAberration": 0.01,
    "lightAngle": 0.785,
    "lightIntensity": 0.5,
    "ambientStrength": 0,
    "refractiveIndex": 1.2,
    "saturation": 1.5
  },
  "fluidBackground": {
    "velocity": 1,
    "bubblesSize": 500,
    "sizeChangingRange": [
      300,
      600
    ],
    "allowColorChanging": true,
    "bubbleMutationDurationSeconds": 4,
    "initialColors": [
      "#4D9EF0",
      "#A06CD5",
      "#F06292",
      "#4DB6AC"
    ]
  },
  "layout": {
    "bannerHeightRatio": 0.1,
    "messageCardMaxHeightRatio": 0.2,
    "clockTextWidthRatio": 0.4,
    "clockPaddingVerticalRatio": 0.05,
    "leftRightRatio": [
      5,
      5
    ],
    "padding": 16,
    "spacing": 8
  },
  "typography": {
    "bannerFontSize": 30,
    "messageFontSize": 28,
    "messageMinFontSize": 14,
    "clockFontSize": 64,
    "subjectCardTitleFontSize": 32,
    "subjectCardDetailFontSize": 26,
    "scheduleHeaderFontSize": 24,
    "scheduleRowFontSize": 22
  }
}